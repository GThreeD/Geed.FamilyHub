{
  "name": "samsung-tv-control-ui",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "build": "npm run format:check && tsc -b && vite build",
    "onlybuild": "tsc -b && vite build",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
